{
  "project": {
    "name": "Unreachable State",
    "description": "State cannot be reached from initial state",
    "locale": "en",
    "timezone": "UTC",
    "laravel_version": "12",
    "filament_version": "v3"
  },
  "roles": [
    { "name": "super-admin", "description": "Admin", "is_super_admin": true }
  ],
  "models": [
    {
      "name": "Order",
      "table": "orders",
      "fields": [
        { "name": "id", "type": "bigInteger" },
        { "name": "status", "type": "string" }
      ],
      "states": {
        "field": "status",
        "initial": "pending",
        "final": ["completed", "abandoned"],
        "transitions": [
          { "from": "pending", "to": "completed", "roles": ["super-admin"] },
          { "from": "disputed", "to": "abandoned", "roles": ["super-admin"] }
        ]
      }
    }
  ],
  "policies": [],
  "filament": { "panels": [] },
  "milestones": [
    {
      "id": "M0",
      "title": "Setup",
      "depends_on": [],
      "scope": ["Order"],
      "acceptance": ["Acc 1", "Acc 2"]
    }
  ]
}
